---
import { lungtaOntologyLinks } from "@scripts/atomicServer";
import ListElement from "@components/resource/listElement.astro";

const links = lungtaOntologyLinks();

---
  <h1>List of Defined Resources in Ara</h1>
  <ul class="mt-4 ml-10">
  {
    links.map((link) => (
      <ListElement link={link} />
    ))
  }
  </ul>