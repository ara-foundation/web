---
import { type NavigationElement } from "@scripts/navigation";
import { getColorCss, getNavigationElementCss } from "@components/lungta/NavigationCss";

interface Props {
    elementProps: NavigationElement;
    elementClass?: string;
    offsetLeft?: boolean;
}

const { elementProps, elementClass, offsetLeft } = Astro.props;
const offsetCss = " ml-4";
---
<li class={(elementClass ?? "") + " " + (offsetLeft ? offsetCss : "")}>
    <span class={getColorCss(elementProps.color) + " " + getNavigationElementCss(elementProps)}>
        {elementProps.title}
    </span>
    <slot />
</li>

<style>
    li {
        margin-bottom: 1rem;
    }
</style>