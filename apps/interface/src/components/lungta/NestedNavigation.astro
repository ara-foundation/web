---
import { type NavigationNode } from "@scripts/navigation";
import NavigationLi from "@components/lungta/NavigationElement.astro";

interface Props {
    node: NavigationNode;
    offsetLeft?: boolean;
}

const { node, offsetLeft } = Astro.props;

const listCss = "menu menu-lg bg-base-200 rounded-box w-56";

---
<NavigationLi elementProps={node.props} offsetLeft={offsetLeft}>
{
    node.children && 
    <ul class={listCss}>
    {
        node.children.map((child) => (
            <Astro.self node={child} offsetLeft={true}></Astro.self>
        ))
    }
    </ul>
}
</NavigationLi>

<style>
    ul {
        margin: 0;
        padding: 0;
        background-color: transparent;
    }

    li {
        margin-bottom: 1rem;
    }
</style>