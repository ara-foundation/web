---
import AraContact from "@components/lungta/AraContact"
import Row from "@layouts/Row.astro"

interface Props {
  footerLink?: string;
  footerText?: string;
}

const { footerLink, footerText } = Astro.props;
---

<footer class="">
  <Row centerClass="flex justify-center" fixToBottom>
    {footerLink && 
      <a href={footerLink} class="btn btn-primary py-6 px-10 mb-4">{footerText}</a>
    }
    <AraContact client:load slot="right" />
  </Row>
</footer>

<style>
.footer {
  /* background-color: var(--color-background);
    color: var(--color-text-base);
    box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
    -webkit-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
    -moz-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
    border-bottom: 2px solid var(--color-border);  */
}
     
.center {
  display: flex;
  justify-content: center;
  align-items: center;
}
</style>