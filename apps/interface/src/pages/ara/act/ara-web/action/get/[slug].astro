//         slug: string,
//     },
// }

// Assert: Support the joint types, for example: type PrimaryKey = string | number | boolean
// type PrimaryKey = string | number | boolean;

// Assert: Support the joint types with nested unions, for example: type Type 2= number | "keyword" | (number|keyword)[]
// type Type2 = number | "keyword" | (number|"keyword")[]

// Assert: Support the custom data as part of union such as false, number, float
// type LiteralType = number | 30 | 1995.05 | boolean | false | true | string | "string literal text"

// Assert: Support the union type with type literal in a syntax list:
// type TypeUnionWithTypeLiteral = number | 30 | 1995.05 | { name: string }

// Assert: Support the literla type with the union type property
// type TypeLiteralWithTypeUnion = {name: string, sex: "male" | "female"}

// Assert Support the Type as non literal nor union, expression
// type ExpressionType = string

// Assert: Support the generic equal type: 
// type Generic<T> = T;

// Assert: Support the generic union: 
// type GenericUnion<T extends number> = T | string

// Assert: Support the generic union in the nested union
// type GenericToNestedUnion<RecordValue extends Array<number>> = number | Record<string, RecordValue>;

// Assert: Conjunction with promitive type is not supported
// type IntersectionWithPrimitive = string[] & number & {name: string} // Should fail

// Assert: Support the Conjunction types
// type Intersection = {numValue: number} & {name: string}

// Assert: Support the conjunction that is never by throwing error:
// type NeverAssert = number & string // will result in never

// Assert: Support union and intersection together
// type UnionIntersection = {name: string} & {girly: boolean} | {masculine: number}

// Assert: parenthesized union
// type ParenthesizedUnionIntersection = {name: string} & ({girly: boolean} | {masculine: number})

// Assert the type that has another type in the reference defined later than this type
// type ComplexType = Profile & {profession: string}
// type Profile = {name: string, age: number}

export async function getStaticPaths() {
    const actions = getActions();

    // const params = [];
    const params: DynamicParam[] = [];

    for (let action of actions) {
        let param = {
            params: {
                slug: action.slug,
            }
        }

        params.push(param);
    }

    return params;
}


const { slug } = Astro.params;
const action = getActionBySlug(slug);

const parentUrl = "/ara/act/ara-web/action/get"

if (action === undefined) {
    return Astro.redirect(parentUrl)
}

// Sub Navigation
const araWebNavigation = newAraWebNavigationNode();

// This page is the ara-web/component/get
if (araWebNavigation.children) {
    for (let child of araWebNavigation.children) {
        if (child.props.slug === "action") {
            const restNode = newRestNode(RestNavigationKey.get);
            const element: NavigationElement = {
                title: action !== undefined ? action.goal : "Unknown action",
                slug: action !== undefined ? action.slug : "slug",
                color: 'primary',
                visible: true,
            }
            const node = elementToNode(element);
            restNode.children?.push(node)
            
            child.children?.push(restNode)
            break;
        }
    }
}

const subNavigation: SubNavigation = {
    projectSlug: AraProjectSlug,
    lungta: LungtaTypes.Act,
    element: araWebNavigation,
}

// SideNavigation
const sideNavigationProps: SideNavigationProps = {
    subNavigation: subNavigation,
    selectedPath: `${parentUrl}/${action && action.slug}`,
}


---
<AraWebLayout
    title={"Action: " + action.goal}
    sideNavigation={sideNavigationProps}
>
    <div>
        <h2>{action.goal}</h2>
        <p>{action.description}</p>
        <ActionTrigger trigger={action.trigger} />
        <div>
            <h2>Flow</h2>
            {action.flow.map((page) => (
                <div class="bg-red-300 my-4 p-2">
                    <ActionPage url={page.url} />
                    <ActionTrigger trigger={page.trigger} />
                </div>
            ))}
        </div>
    </div>
    <section slot={cancelSlug}>
        <a href={parentUrl} class="btn btn-outline btn-error w-full mb-4">Back to List of Actions</a>
    </section>
</AraWebLayout>