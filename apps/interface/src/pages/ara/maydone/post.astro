---
/**
 * @this Page
 * @param {string} Title Create a new MayDone
 * @param {string} Description POST Rest API operation on MayDone.
 */
import type { SideNavigationProps } from "@components/lungta/SideNavigation.astro";
import AraWebLayout, {type FooterAction} from "@layouts/AraWebLayout.astro"
import { LungtaTypes } from "@scripts/lungtaTypes";
import { AraProjectSlug, newRestNode, RestNavigationKey, type SubNavigation } from "@scripts/navigation";
import { ColumnSlug, fullSlug, RowSlug, type LayoutProps } from "@scripts/page";

const footerAction: FooterAction = {
    url: "/ara/sangha/post",
    label: "Set Budget"
}

const layoutProps: LayoutProps = {
    content: {
        columnClasses: {
            center: "flex flex-col px-4 h-full mt-20",
            right: "pr-4 mt-20"
        }
    },
}

const cancelSlug = fullSlug(RowSlug.Content, ColumnSlug.Right);

const subNavigation: SubNavigation = {
    projectSlug: AraProjectSlug,
    lungta: LungtaTypes.Maydone,
    element: newRestNode(RestNavigationKey.post)
}

const sideNavigationProps: SideNavigationProps = {
    selectedPath: "/ara/maydone/post",
    subNavigation: subNavigation,
}

---

<AraWebLayout 
    title="Set Project Budget" 
    footerAction={footerAction}
    layoutProps={layoutProps}
    sideNavigation={sideNavigationProps}
>
    <section>
        <h2>Project Budget</h2>
        <input type="number" placeholder="Budget" class="input input-bordered w-full mb-2" />
        <textarea class="textarea textarea-bordered textarea-lg w-full min-h-80" placeholder="Describe how do you spend the budget"></textarea>
    </section>
    <section slot={cancelSlug}>
        <a href="/" class="btn btn-outline btn-error w-full mb-4">Cancel</a>
        <a href="/ara/logos/post" class="btn btn-outline btn-neutral w-full">Previous</a>
    </section>
</AraWebLayout>
