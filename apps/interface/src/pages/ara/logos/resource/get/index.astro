---
import AraWebLayout from "@layouts/AraWebLayout.astro"
import { 
    type SubNavigation, 
    NewAraNavigation, 
    type NavigationNode, 
    RestNavigationKey, 
    restNavigationKeyToNavigationElement,
    navigationElementToNavigationNode } from "@scripts/navigation";
import { LungtaTypes } from "@scripts/lungtaTypes";
import { type SideNavigationProps } from "@components/lungta/SideNavigation.astro";
import ListElement from "@components/resource/listElement.astro";
import { lungtaOntologyLinks } from "@scripts/atomicServer";

const resourceNavigation: NavigationNode = {
    props: {
        title: "Resource",
        slug: "resource",
        color: "pink",
        visible: true,
        selected: true,
    },
    children: [
        // GET REST
        navigationElementToNavigationNode(restNavigationKeyToNavigationElement(RestNavigationKey.get))
    ]
}

const resourceSubNavigation: SubNavigation = {
    projectSlug: NewAraNavigation().props.slug,
    lungta: LungtaTypes.Logos,
    element: resourceNavigation,
}

const sideNavigation: SideNavigationProps = {
    subNavigation: resourceSubNavigation,
    selectedPath: "ara/logos/resource/get"
}

const links = lungtaOntologyLinks();

---

<AraWebLayout sideNavigation={sideNavigation}>
    <h1>List of Defined Resources in Ara</h1>
    <ul class="mt-4 ml-10">
    {
        links.map((link) => (
            <ListElement link={link} />
        ))
    }
    </ul>
</AraWebLayout>