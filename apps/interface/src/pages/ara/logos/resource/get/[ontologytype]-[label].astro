---
/**
 * @this Page
 * @param {string} Title A specific resource page
 * @param {string} Description A page with the resource and its parameters
 */
import { lungtaOntologyLinks, findLink, OntologyType } from "@scripts/atomicServer";
import { type SideNavigationProps } from "@components/lungta/SideNavigation.astro";
import { elementToNode, newAraProject, RestNavigationKey, newRestElement, type NavigationElement, type NavigationNode, type SubNavigation } from "@scripts/navigation";
import { LungtaTypes } from "@scripts/lungtaTypes";
import AraWebLayout from "@layouts/AraWebLayout.astro"
import Resource from "@components/resource/Resource";

type DynamicParam = {
    params: {
        ontologytype: string,
        label: string,
    }
}

export async function getStaticPaths() {
    const links = lungtaOntologyLinks();

    const params: DynamicParam[] = [];

    for (let link of links) {
        let param = {
            params: {
                ontologytype: link.type,
                label: link.label
            }
        }

        params.push(param);
    }

    return params;
}


const { ontologytype, label } = Astro.params;
const link = findLink(ontologytype as OntologyType, label);

if (link === undefined) {
    return Astro.redirect(`/ara/logos/resource/get`)
}



const resourceNavigationElement: NavigationElement = {
    title: `${label} (${ontologytype})`,
    slug: label,
    color: ontologytype === 'class' ? 'primary' : 'secondary',
    visible: true,
}
const resourceNavigationNode = elementToNode(resourceNavigationElement);

const restGetNavigationElement = newRestElement(RestNavigationKey.get);
const restGetNavigationNode = elementToNode(restGetNavigationElement);
restGetNavigationNode.children?.push(resourceNavigationNode);

const resourceNavigation: NavigationNode = {
    props: {
        title: "Resource",
        slug: "resource",
        color: "pink",
        visible: true,
        selected: true,
    },
    children: [
        restGetNavigationNode,
    ]
}

const resourceSubNavigation: SubNavigation = {
    projectSlug: newAraProject().props.slug,
    lungta: LungtaTypes.Logos,
    element: resourceNavigation,
}

const sideNavigation: SideNavigationProps = {
    subNavigation: resourceSubNavigation,
    selectedPath: "ara/logos/resource/get/" + resourceNavigationElement.slug
}

---
<AraWebLayout sideNavigation={sideNavigation}>
    <Resource subject={link.url} />
    <a slot="right" href="/ara/logos/resource/get">Back</a>
</AraWebLayout>