---
/**  
 * @this Page 
 * @param {string} Title Create a new Logos
 * @param {string} Description POST Rest API operation on Logos.
*/
import AraWebLayout, {type FooterAction} from "@layouts/AraWebLayout.astro"
import { LungtaTypes } from "@scripts/lungtaTypes";
import { AraProjectSlug, newRestNode, RestNavigationKey, type SubNavigation } from "@scripts/navigation";
import { slugsToLayoutPath } from "@scripts/page";
import { RowSlug, ColumnSlug, type LayoutProps } from "@scripts/araWebOntology";
import { type SideNavigationProps } from "@components/lungta/SideNavigation.astro";

const footerAction: FooterAction = {
    url: "/ara/maydone/post",
    label: "Create Project",
}

const layoutProps: LayoutProps = {
    content: {
        columnClasses: {
            center: "flex flex-col px-4 h-full mt-20",
            right: "pr-4 mt-20"
        }
    },
}

const subNavigation: SubNavigation = {
    projectSlug: AraProjectSlug,
    lungta: LungtaTypes.Logos,
    element: newRestNode(RestNavigationKey.post),
}

const sideNavigationProps: SideNavigationProps = {
    subNavigation: subNavigation,
    selectedPath: "/ara/logos/post",
}

const rightContentSlug = slugsToLayoutPath(RowSlug.Content, ColumnSlug.Right);
---

<AraWebLayout 
    title="New Logos" 
    footerAction={footerAction} 
    layoutProps={layoutProps}
    sideNavigation={sideNavigationProps}
>
    <section>
        <h2>Project Parameters</h2>
        <p>Communities are built around the projects</p>
        <input type="text" placeholder="Project Name" class="input input-bordered w-full mb-2" />
        <textarea class="textarea textarea-bordered textarea-lg w-full min-h-80" placeholder="Description"></textarea>
    </section>
    <a slot={rightContentSlug} href="/" class="btn btn-outline btn-error w-full mb-4">Cancel</a>
</AraWebLayout>
