---
export interface Props {
  rowClass?: string;
  leftClass?: string;
  rightClass?: string;
  centerClass?: string;
  fixToBottom?: boolean;
  fixToTop?: boolean;
}

let { rowClass, leftClass, rightClass, centerClass, fixToBottom, fixToTop } = Astro.props;

let stickClass = "fixed inset-x-0 ";
if (fixToBottom) {
    stickClass += " bottom-0 z-1000"
} else if (fixToTop) {
    stickClass += " top-0 z-1000"
} else {
    stickClass = "";
}

---

<div class={"flex flex-row  " + (rowClass ?? "") + stickClass}>
    <div class={"basis-1/6 " + (leftClass ?? "")}>
        <slot name="left" />
    </div>
    <div class={"basis-2/3 " + (centerClass ?? "")}>
        <slot />
    </div>
    <div class={"basis-1/6 " + (rightClass ?? "")}>
        <slot name="right" />
    </div>
</div>