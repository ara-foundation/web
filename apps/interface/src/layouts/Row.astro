---
/**
 * Row Component defines the Row Layout which is composed of three columns.
 * The web page is the list of the Row components
 */
import { ColumnSlug, RowSlug } from "@scripts/page";

export type RowProps = {
    rowClass?: string;
    columnClasses?: {
        // Custom classes for the columns
        [key in ColumnSlug]?: string;
    },
    fix?: {
        // Fix The Row?
        [key in RowSlug]?: boolean;
    }
}
interface Props extends RowProps {}

let { rowClass, fix, columnClasses } = Astro.props;

let stickClass = "fixed inset-x-0 ";
if (fix !== undefined && fix.footer) {
    stickClass += " bottom-0 z-1000"
} else if (fix !== undefined && fix.header) {
    stickClass += " top-0 z-1000"
} else {
    stickClass = "";
}

---

<div class={"flex flex-row  " + (rowClass ?? "") + stickClass}>
    <div class={"basis-1/6 " + (columnClasses?.left ?? "")}>
        <slot name='left' />
    </div>
    <div class={"basis-2/3 " + (columnClasses?.center ?? "")}>
        <slot name='center' />
    </div>
    <div class={"basis-1/6 " + (columnClasses?.right ?? "")}>
        <slot name='right' />
    </div>
</div>