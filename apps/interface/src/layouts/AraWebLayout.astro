---
/**
 * The template that Ara Web itself uses.
 * It's based on the primary layout (EmptyBodyLayout.astro) and populates
 * The Top with the Ara Logo, Notification and Login,
 * Meanwhile the footer is populated by Sever AI, optionally an action.
 * And for the content, it's left is filled with the SideNavigation.
 */
import EmptyBodyLayout from "@layouts/EmptyBodyLayout.astro";
import { 
	RowSlug, 
	ColumnSlug, 
	fullSlug, 
	contentLeftSlug, 
	contentRightSlug, 
	type LayoutProps, 
} from "@scripts/page";
import SideNavigation, {type SideNavigationProps} from "@components/lungta/SideNavigation.astro";

// HEADER
// import Login from "@components/auth/Login"
import Logo from '@components/header/LogoContainer.astro'
import Notification from '@components/header/Notification.astro';
import Login from "@components/auth/ZkLogin"
// FOOTER
import AraContact from "@components/lungta/AraContact"

export type FooterAction = {
	url: string;
	label: string;
}

interface Props {
	footerAction?: FooterAction,
	sideNavigation?: SideNavigationProps,
	title?: string,
	layoutProps?: LayoutProps,
}

let { 
	footerAction,
	sideNavigation,
	title,
	layoutProps,
} = Astro.props;

layoutProps ??= {}
layoutProps.header ??= {}
layoutProps.header.fix ??= {};
layoutProps.header.columnClasses ??= {};
layoutProps.content ??= {};
layoutProps.content.columnClasses ??= {};
layoutProps.footer ??= {}
layoutProps.footer.fix ??= {};
layoutProps.footer.columnClasses ??= {};

// Add Ara Web's default parameters to the Layout
if (layoutProps?.header?.fix?.header === undefined) {
	layoutProps.header.fix.header = true;
}
if (layoutProps?.header?.columnClasses?.center === undefined) {
	layoutProps!.header!.columnClasses!.center = "flex justify-center"
} 

if (layoutProps?.content?.columnClasses?.left === undefined) {
	layoutProps.content!.columnClasses.left = "mt-20"
} 
if (layoutProps?.content?.columnClasses?.center === undefined) {
	layoutProps.content.columnClasses!.center = "mt-20"
} 
if (layoutProps?.content?.columnClasses?.right === undefined) {
	layoutProps.content.columnClasses!.right = "mt-20"
} 

if (layoutProps?.footer?.fix?.footer === undefined) {
	layoutProps!.footer!.fix.footer = true;
}
if (layoutProps?.footer?.columnClasses?.center === undefined) {
	layoutProps.footer.columnClasses.center = "flex justify-center"
}

const headerLeftSlug = fullSlug(RowSlug.Header, ColumnSlug.Left);
const headerCenterSlug = fullSlug(RowSlug.Header, ColumnSlug.Center);
const headerRightSlug = fullSlug(RowSlug.Header, ColumnSlug.Right);

const footerCenterSlug = fullSlug(RowSlug.Footer, ColumnSlug.Center);
const footerRightSlug = fullSlug(RowSlug.Footer, ColumnSlug.Right);
---

<EmptyBodyLayout rows={layoutProps} title={title}>
	<!-- HEADER -->
	<Logo slot={headerLeftSlug} />
	<Notification text="Exclusive Early Adoper Version!" slot={headerCenterSlug} />
	<Login client:only slot={headerRightSlug} />

	<!-- CONTENT -->
	<SideNavigation subNavigation={sideNavigation && sideNavigation.subNavigation} selectedPath={sideNavigation && sideNavigation.selectedPath} slot={contentLeftSlug} />
	<!-- anything after side navigation, to show on the left side -->
	<slot name="content-left" slot={contentLeftSlug} />
	
	<slot slot="content-center" />
	<slot name="content-right" slot={contentRightSlug} />

	<!-- FOOTER -->
	{footerAction && 
	<a 
		href={footerAction.url} 
		class="btn btn-primary py-6 px-10 mb-4" 
		slot={footerCenterSlug}
	>
		{footerAction.label}
	</a>
	}
	<AraContact client:load slot={footerRightSlug} />
</EmptyBodyLayout>

<script>
	const hamburger = document.querySelector('.hamburger');
    const menu = document.querySelector('.menu');

    hamburger?.addEventListener('click', () => {
        menu?.classList.toggle('active');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
    	const target = event.target as HTMLElement;
        if (!target.closest('.nav') && menu?.classList.contains('active')) {
            menu.classList.remove('active');
        }
    });
</script>

<style>
    .header {
        /* position: sticky; */
        /* top: 0; */
        /* display: flex; */
        /* justify-content: space-between; */
        /* align-items: baseline; */
        /* background-color: var(--color-background); */
        /* color: var(--color-text-base); */
        /* box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5); */
        /* -webkit-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5); */
        /* -moz-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5); */
        z-index: 1000;
        /* border-bottom: 2px solid var(--color-border);  */
    }

    .logo {
        display: flex;
        align-items: center;
        color: var(--color-text-base);
    }

    .logo a {
        display: flex;
        align-items: center;
        padding: 0 0.25em;
    }

    .logo #home:hover {
        color: var(--color-link);
	}

    .logo svg {
        width: 32px;
    }

    .logo svg path {
        fill: none;
        stroke: var(--color-text-base);
    }

    .logo #home {
        font-size: var(--step-1);
        margin-right: 10px;
        color: var(--color-text-base);
        text-decoration: none;
    }

  	.center {
    	display: flex;
    	justify-content: center;
    	/* align-items: center; */
  	}

	.footer {
		/* background-color: var(--color-background);
			color: var(--color-text-base);
			box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
			-webkit-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
			-moz-box-shadow: 2px 9px 24px 0px rgba(0,0,0,0.5);
			border-bottom: 2px solid var(--color-border);  */
	}
			
	.center {
		display: flex;
		justify-content: center;
		align-items: center;
	}
</style>