{
    "extends": "astro/tsconfigs/strict",
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
      "downlevelIteration": true,
      "esModuleInterop": true,
      "verbatimModuleSyntax": true,
      "moduleResolution": "node16",
      "module": "Node16",
      "lib": [
        "dom",
        "es2016"
      ],
      "resolveJsonModule": true,
      "baseUrl": "src",
      "paths": {
        "@content/*": [
          "content/*"
        ],
        "@layouts/*": [
          "layouts/*"
        ],
        "@components/*": [
          "components/*"
        ],
        "@scripts/*": [
          "scripts/*"
        ],
        "@styles/*": [
          "styles/*"
        ],
        "@ontologies/*": [
          "ontologies/*"
        ]
      },
      "jsx": "react-jsx",
      "jsxImportSource": "react"
    }
  }