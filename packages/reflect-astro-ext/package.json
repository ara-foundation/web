{
  "name": "@ara-web/reflect-astro-ext",
  "type": "module",
  "author": "Medet Ahmetson",
  "license": "ISC",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm lint && pnpm build",
    "_chore": "pnpm i",
    "test": "vitest -r ./",
    "check-test-files": "astro check --root ./test/test-app/",
    "lint": "eslint"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@ara-web/reflect-eslint-proxy": "workspace:*",
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.16",
    "@types/react": "19.1.2",
    "css-select": "^5.1.0",
    "css-what": "^6.1.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "dependencies": {
    "@ara-web/p-hintjens": "workspace:*",
    "@ara-web/sds": "workspace:*",
    "@astrojs/check": "0.9.4",
    "@astrojs/compiler": "^2.11.0",
    "@astrojs/react": "4.2.5",
    "@types/react-dom": "19.1.2",
    "astro": "^5.7.10",
    "comment-parser": "^1.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.3",
    "vitest": "2.1.6"
  },
  "peerDependencies": {
    "@ara-web/reflect": "workspace:*"
  }
}
