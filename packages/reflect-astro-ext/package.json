{
  "name": "@ara-web/reflect-astro-ext",
  "type": "module",
  "author": "Medet Ahmetson",
  "license": "ISC",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm lint && pnpm build",
    "_chore": "pnpm i",
    "test": "vitest -r ./",
    "check-test-files": "astro check --root ./test/test-app/",
    "lint": "eslint"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.10",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.31.1",
    "@ara-web/reflect-eslint-proxy": "workspace:*"
  },
  "dependencies": {
    "@ara-web/p-hintjens": "workspace:*",
    "@astrojs/check": "^0.9.4",
    "@astrojs/compiler": "^2.11.0",
    "@astrojs/react": "^4.2.0",
    "@types/react-dom": "^19.0.4",
    "astro": "^5.7.5",
    "comment-parser": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.2.11",
    "vitest": "2.1.6"
  },
  "peerDependencies": {
    "@ara-web/reflect": "workspace:*"
  }
}
