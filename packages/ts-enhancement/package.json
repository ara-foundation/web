{
  "name": "@ara-web/ts-enhancement",
  "type": "module",
  "author": "Medet Ahmetson",
  "license": "ISC",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm test:lint && pnpm build",
    "_chore": "pnpm i"
  },
  "imports": {
    "#main": "./src/index.ts",
    "#ara-link": "./src/ara-link/AraLink.ts",
    "#ontology": "./src/ara-web-ontology/index.ts",
    "#traits": "./src/traits/index.ts",
    "#debug": "./src/debug.ts",
    "#result": "./src/result.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./ara-link": {
      "types": "./src/ara-link/AraLink.ts",
      "default": "./dist/ara-link/AraLink.js"
    },
    "./module-link": {
      "types": "./src/ara-link/ModuleLink.ts",
      "default": "./dist/ara-link/ModuleLink.js"
    },
    "./ontology": {
      "types": "./src/ara-web-ontology/index.ts",
      "default": "./dist/ara-web-ontology/index.js"
    },
    "./traits": {
      "types": "./src/traits/index.ts",
      "default": "./dist/traits/index.js"
    },
    "./debug": {
      "types": "./src/debug.ts",
      "default": "./dist/debug.js"
    },
    "./result": {
      "types": "./src/result.ts",
      "default": "./dist/result.js"
    }
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@types/node": "^20.10.5",
    "packageurl-js": "^2.0.1"
  }
}
