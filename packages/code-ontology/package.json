{
  "name": "@ara-web/code-ontology",
  "version": "1.0.0",
  "type": "module",
  "description": "This package evaluates Javascript/Typescript source code and the result is turned into ontological JSON format",
  "license": "ISC",
  "main": "dist",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm test:lint && tsc",
    "_chore": "pnpm i",
    "test": "vitest -r ./"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ara-web/p-hintjens": "workspace:*",
    "@ara-web/reflect": "workspace:*",
    "@ara-web/sds": "workspace:*",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.16",
    "vite": "^6.3.3",
    "vitest": "2.1.6"
  }
}
