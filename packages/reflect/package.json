{
  "name": "@ara-web/reflect",
  "version": "1.0.0",
  "type": "module",
  "description": "Reflect on it's own code structure and alter it",
  "license": "ISC",
  "main": "dist",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm test:lint && tsc",
    "_chore": "pnpm i",
    "test": "vitest -r ./"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./nodejs-ext": {
      "types": "./src/builtin-module-manager.ts",
      "default": "./dist/builtin-module-manager.js"
    }
  },
  "dependencies": {
    "@ara-web/p-hintjens": "workspace:*",
    "@ara-web/sds": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.16",
    "vite": "^6.3.3",
    "vitest": "2.1.6"
  }
}
