{
  "name": "@ara-web/reflect",
  "version": "1.0.0",
  "type": "module",
  "description": "Reflect on it's own code structure and alter it",
  "license": "ISC",
  "main": "dist",
  "dependencies": {
    "@ara-web/ts-enhancement": "workspace:*",
    "packageurl-js": "^2.0.1",
    "ts-morph": "^25.0.1"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm test:lint && tsc",
    "_chore": "pnpm i",
    "test": "vitest"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./nodejs-ext": {
      "types": "./src/reflect-nodejs-ext/index.ts",
      "default": "./dist/reflect-nodejs-ext/index.js"
    },
    "./memory": {
      "types": "./src/memory/index.ts",
      "default": "./dist/memory/index.js"
    },
    "./code-level": {
      "types": "./src/code-level/Code.ts",
      "default": "./dist/code-level/Code.js"
    },
    "./code-level/ts-node": {
      "types": "./src/code-level/ts-node.ts",
      "default": "./dist/code-level/ts-node.js"
    },
    "./code-level/ast-node": {
      "types": "./src/code-level/ast-node.ts",
      "default": "./dist/code-level/ast-node.js"
    },
    "./code-level/ast-node@types": {
      "types": "./src/code-level/ast-node-data.ts",
      "default": "./dist/code-level/ast-node-data.js"
    },
    "./code-level/variable-level/variable-statement": {
      "types": "./src/code-level/variable-level/variable-statement.ts",
      "default": "./dist/code-level/variable-level/variable-statement.js"
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "vite": "^5.2.11",
    "vitest": "^3.1.1"
  }
}
