{
  "name": "@ara-web/sds",
  "version": "0.0.1",
  "type": "module",
  "author": "Medet Ahmetson",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MPL-2.0",
  "description": "A package to build modular plug-and-play architecture for your code",
  "scripts": {
    "dev": "tsc --watch",
    "build": "pnpm _chore && rm -rf dist && tsc",
    "prepublishOnly": "pnpm test && pnpm build",
    "_chore": "pnpm i",
    "test": "vitest -r ./"
  },
  "keywords": [
    "library",
    "sds",
    "ara"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/ara-foundation/web.git",
    "directory": "packages/sds"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "2.1.6"
  },
  "dependencies": {
    "@ara-web/p-hintjens": "*",
    "@types/node": "^22.15.16",
    "css-select": "^5.1.0",
    "css-what": "^6.1.0",
    "packageurl-js": "^2.0.1"
  }
}
