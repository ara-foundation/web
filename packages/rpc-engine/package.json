{
  "name": "@ara-web/rpc-engine",
  "description": "Ara Web's RPC Engine allowing to call some local or remote functions",
  "repository": {},
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm _chore && astro dev",
    "build": "pnpm _chore && rm -rf dist && astro build",
    "prepublishOnly": "pnpm test:lint && astro build",
    "_chore": "pnpm i"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./AstroComponentCall": "./src/components/call.astro",
    "./AstroComponentRpcCard": "./src/components/rcpCard.astro"
  },
  "dependencies": {
    "@ara-web/p-hintjens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "astro": "^5.7.10",
    "vite": "^6.3.3"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  }
}
