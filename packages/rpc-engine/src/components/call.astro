---
/**
 * A generic extension.
 */
import { type RpcCallType } from "../types";
import { rpcBySlug } from "../rpc"
import { StringTraits } from "@ara-web/ts-enhancement";

interface Props {
    rpcCall?: RpcCallType
};

const {
    rpcCall
 } = Astro.props;

---

<div >
    <h2>RPC Calling</h2>
    <p><b>RPC Type:</b> {rpcCall?.rpcType && "Rpc Type (Extension, Proxy, Independent)"}</p>
    <p><b>Slug:</b> {rpcCall?.slug && "slug to identify within the Ara Web"}</p>
    <hr class="mt-4 mb-2" />
    <h3>Inputs:</h3>
    <ul>
        {rpcCall?.inputs.map((input, index) => (
            <li>
                The <code class="text-gray-200 bg-gray-900 mr-2">{StringTraits.capitalizeFirstLetter(rpcBySlug(rpcCall.slug)?.inputDescriptions[index].type!)}</code>: 
                <i class="text-gray-500 mr-2">
                    ({StringTraits.capitalizeFirstLetter(rpcBySlug(rpcCall.slug)?.inputDescriptions[index].type!)})
                </i> {input}
            </li>
        ))}
    </ul>
    <hr class="mt-4 mb-2" />
    <h3>Outputs:</h3>
    <p class="text-gray-500"><i>Not implemented yet!</i></p>
</div>